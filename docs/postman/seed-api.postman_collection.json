                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "Restore record (ADMIN)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/sample-records/{{recordId}}/restore"
            },
            "description": "Clears the deletion.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Export and operations",
      "item": [
        {
          "name": "Start export",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/sample-records/export"
            },
            "description": "Starts a long-running export: 202 with `Location` and the operation. Saves `operationId`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 202', () => pm.response.to.have.status(202));",
                  "const d = pm.response.json().data;",
                  "pm.collectionVariables.set('operationId', d.operationId);",
                  "pm.test('QUEUED v1', () => { pm.expect(d.status).to.eql('QUEUED'); pm.expect(d.version).to.eql(1); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Get operation (poll)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/operations/{{operationId}}"
            },
            "description": "QUEUED \u2192 RUNNING \u2192 SUCCEEDED/FAILED; `version` rises on each change. Live pushes: STOMP `/topic/operations/{id}` on ws://localhost:8080/ws (not supported by Postman's HTTP requests)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "console.log('status', pm.response.json().data.status, 'version', pm.response.json().data.version);"
                ]
              }
            }

        {
          "name": "Unknown operation \u2192 404",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/operations/00000000-0000-7000-8000-000000000000"
            },
            "description": "OPERATION_NOT_FOUND."
